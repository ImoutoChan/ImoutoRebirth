    "mini-css-extract-plugin": "^2.7.6",
    "mkdirp": "^1.0.4",
    "rimraf": "^3.0.2",
    "sass": "^1.51.0",
    "sass-loader": "^12.6.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^8.10.2",
